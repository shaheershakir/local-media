# LocalFeed — Edit this file with your actual media paths and save as .env
# Copy this to f:\local-media\backend\.env

# ── REQUIRED: Your media directories ──────────────────────────────────────
# Comma-separated absolute paths. Both videos and images can be in the same roots.
# Example (Windows):
#   MEDIA_ROOTS=C:\Users\YourName\Videos,C:\Users\YourName\Pictures,D:\Media
MEDIA_ROOTS="E:\Telegram Downlaods"

# ── OPTIONAL: Cache directories ────────────────────────────────────────────
# Defaults to ~/.localfeed/thumbnails and ~/.localfeed/transcoded if blank
THUMBNAIL_DIR=
TRANSCODED_DIR=

# ── OPTIONAL: Database path ────────────────────────────────────────────────
# Defaults to ~/.localfeed/localfeed.db if blank
DB_PATH=

# ── Server settings ────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# ── Performance tuning ─────────────────────────────────────────────────────
THUMBNAIL_WIDTH=400
THUMBNAIL_WORKERS=2
MAX_PAGE_SIZE=50
