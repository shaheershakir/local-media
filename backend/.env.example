# LocalFeed Configuration
# Copy this to .env and edit for your setup

# Comma-separated list of absolute paths to scan for media
# Example: C:\Users\YourName\Videos,C:\Users\YourName\Pictures
MEDIA_ROOTS=C:\Users\YourName\Videos,C:\Users\YourName\Pictures

# Where to store generated thumbnails (default: ~/.localfeed/thumbnails)
THUMBNAIL_DIR=

# Where to store transcoded video cache (default: ~/.localfeed/transcoded)
TRANSCODED_DIR=

# Where to store the SQLite database (default: ~/.localfeed/localfeed.db)
DB_PATH=

# Server config
HOST=127.0.0.1
PORT=8000

# Maximum number of items per page for grid/folder endpoints
MAX_PAGE_SIZE=50

# Scanner performance tuning (8 is optimal for HDD storage, 12-16 for SSD)
SCAN_METADATA_WORKERS=8
SCAN_DB_BATCH_SIZE=1000


# Thumbnail dimensions (width in pixels; height is auto-scaled)
THUMBNAIL_WIDTH=400

# Number of background thumbnail worker threads (keep low to avoid I/O saturation)
THUMBNAIL_WORKERS=2
